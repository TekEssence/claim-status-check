# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS worker

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    CLAIM_STATUS_RUNTIME_DIR=/tmp/claim-status-artifacts \
    BROWSER_HEADLESS=true \
    BROWSER_KEEP_OPEN=false

RUN --mount=type=cache,target=/root/.npm \
    npx --yes playwright@1.61.1 install-deps chromium \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /ms-playwright /app/data /app/incoming /tmp/claim-status-artifacts

COPY worker-runtime/package.json worker-runtime/package-lock.json ./
RUN --mount=type=cache,id=claim-status-worker-npm,target=/root/.npm,sharing=locked \
    npm config set fetch-retries 10 \
    && npm config set fetch-retry-factor 2 \
    && npm config set fetch-retry-mintimeout 20000 \
    && npm config set fetch-retry-maxtimeout 300000 \
    && npm config set fetch-timeout 600000 \
    && npm config set maxsockets 3 \
    && npm ci --omit=dev --omit=optional --no-audit --no-fund --prefer-offline

COPY tsconfig.json ./
COPY backend ./backend
COPY db ./db
COPY lib ./lib

RUN --mount=type=cache,target=/root/.npm \
    npx --yes playwright@1.61.1 install chromium \
    && rm -rf /tmp/* /var/tmp/* /root/.cache \
    && mkdir -p /tmp/claim-status-artifacts \
    && chown -R node:node /app/data /app/incoming /tmp/claim-status-artifacts

USER node

CMD ["npm", "run", "worker:claim-status"]
